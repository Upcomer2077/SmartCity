FROM python:3.14-alpine AS builder

# Import uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
WORKDIR /simulator

# Copy workspace configuration files to prepare for sync
COPY uv.lock  pyproject.toml .python-version ./
COPY sensorapi/pyproject.toml sensorapi/
COPY common/pyproject.toml common/

# Prefetch and sync dependencies using Docker cache mounts
RUN  --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-install-project --no-editable

# Include source code for internal workspaces
COPY sensorapi/  sensorapi/
COPY common/ common/

# Finalize the build with all workspace packages installed
RUN --mount=type=cache,target=/root/.cache/uv \ 
    uv sync --all-packages --no-editable 

FROM python:3.14-alpine AS runner
# Prevent Python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1
WORKDIR /simulator

COPY --from=builder /simulator/.venv/ .venv/
# TODO: Temporary SQLite database inclusion for testing purposesCOPY "db.db" ./db.db
ENV PATH="/simulator/.venv/bin:$PATH"
CMD ["sensor"]
